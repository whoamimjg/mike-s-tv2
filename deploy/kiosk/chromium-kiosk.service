# Boots straight into the Mike TV UI full-screen on the HDMI output.
# Runs its own minimal X server via xinit as the "kiosk" user — no desktop.
#
#   sudo cp deploy/kiosk/chromium-kiosk.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chromium-kiosk
#
[Unit]
Description=Mike TV kiosk (Chromium full-screen)
After=network-online.target mike-tv.service systemd-user-sessions.service
Wants=network-online.target

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty7
Environment=MIKE_TV_URL=http://localhost:4950
# xinit starts X on display :0 / vt7 and runs our kiosk script as the X client.
ExecStart=/usr/bin/xinit /opt/mike-tv/deploy/kiosk/start-kiosk.sh -- :0 vt7 -nolisten tcp -keeptty
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
